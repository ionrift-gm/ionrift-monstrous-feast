{
    "id": "ionrift-monstrous-feast",
    "title": "Monstrous Feast",
    "description": "Butcher and cook the monsters you kill. Turn slain creatures into ingredients, cook them at camp, and feed the party. Monster hunting and creature cooking for Foundry VTT, in the spirit of delicious dungeon crawling.",
    "version": "1.0.3",
    "url": "https://github.com/ionrift-gm/ionrift-monstrous-feast",
    "manifest": "https://github.com/ionrift-gm/ionrift-monstrous-feast/releases/latest/download/module.json",
    "download": "https://github.com/ionrift-gm/ionrift-monstrous-feast/releases/download/v1.0.3/module.zip",
    "compatibility": {
        "minimum": "12",
        "verified": "13"
    },
    "esmodules": [
        "scripts/module.js"
    ],
    "socket": true,
    "styles": [
        "styles/mf-chrome.css",
        "styles/mf-cookbook.css",
        "styles/mf-cook-session.css",
        "styles/mf-feast.css",
        "styles/mf-ceremony.css",
        "styles/mf-codex.css"
    ],
    "packs": [
        {
            "name": "mf-starter",
            "label": "Monstrous Feast Starter",
            "type": "Item",
            "system": "dnd5e",
            "path": "packs/mf-starter",
            "ownership": {
                "GAMEMASTER": "OWNER"
            }
        }
    ],
    "packFolders": [
        {
            "name": "Ionrift",
            "color": "#8b5cf6",
            "folders": [
                {
                    "name": "Monstrous Feast",
                    "packs": ["mf-starter"]
                }
            ]
        }
    ],
    "relationships": {
        "requires": [
            {
                "id": "ionrift-library",
                "type": "module",
                "manifest": "https://github.com/ionrift-gm/ionrift-library/releases/download/v2.5.12/module.json",
                "compatibility": {
                    "minimum": "2.5.12"
                }
            }
        ],
        "recommends": [
            {
                "id": "dae",
                "type": "module",
                "reason": "Expires meal buffs at the right moment: after the next save or check, and at rest."
            },
            {
                "id": "midi-qol",
                "type": "module",
                "reason": "Drives advantage and save bonuses on rolls during play."
            }
        ]
    },
    "authors": [
        {
            "name": "Ionrift",
            "url": "https://patreon.com/ionrift"
        }
    ]
}
